          "name": "high_precision",
          "display_name": "深度学习高精度模式",
          "intrinsic_type": "boolean",
          "default_type": "boolean",
          "default_value": "true",
          "presets": [
            "true",
            "false"
          ],
          "description": "开启后将调用 CNN 定位与超分增强，极大改善模糊与畸变识别率"
        }
      ],
      "output_type": "string"
    },
