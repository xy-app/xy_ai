        {
          "name": "barcode_format",
          "display_name": "目标码制",
          "intrinsic_type": "string",
          "default_type": "string",
          "default_value": "auto",
          "presets": [
            "auto",
            "qr_code",
            "code_128",
            "ean_13",
            "data_matrix"
