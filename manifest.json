        },
        {
          "name": "height",
          "display_name": "高度(像素)",
          "intrinsic_type": "number",
          "default_type": "number",
          "default_value": "300",
          "presets": [
            "100",
            "200",
            "300"
          ],
          "description": "生成图像的像素高度"
        }
      ],
      "output_type": "string"
    },
    {
