{
  "plugin_id": "xy_ai",
  "name": "AI 视觉与文字识别 (AI & OCR)",
  "version": "0.51.0",
  "group": "AI",
  "group_icon": "🤖",
  "description": "提供屏幕文字识别 (OCR)、查找屏幕文字、表格提取、条码识别、AI 大模型问答以及智能定位屏幕元素等功能",
  "actions": [
    {
      "tag": "OpenAiService",
      "display_name": "本地模型服务与推理 (OpenAiService)",
      "icon": "🧠",
      "platforms": "All",
      "description": "调用本地或远程 AI 大模型进行提问与智能对话，支持生成文本或结构化数据",
      "keywords": [
        "openai",
        "shimmy",
        "llm",
        "大模型",
        "本地模型",
        "推理服务",
        "ollama",
        "vllm"
      ],
      "fields": [
        {
          "name": "action",
          "display_name": "操作模式",
          "intrinsic_type": "string",
          "default_type": "string",
          "default_value": "chat",
          "presets": [
            "chat",
            "start_server",
            "stop_server",
            "status"
          ],
          "description": "执行推理对话(chat)或服务启停管理"
        },
        {
          "name": "model_name",
          "display_name": "模型标识",
          "intrinsic_type": "string",
          "default_type": "string",
          "default_value": "qwen2.5:7b",
          "presets": [
            "qwen2.5:7b",
            "deepseek-r1:1.5b",
            "llama-3.2:3b"
          ],
          "description": "模型名称或远程模型标识"
        },
        {
          "name": "model_path",
          "display_name": "本地 GGUF 模型路径",
          "intrinsic_type": "FilePicker",
          "default_type": "string",
          "default_value": "",
          "presets": [],
          "description": "用于本地 Shimmy 引擎加载的 .gguf 模型权重文件"
        },
        {
          "name": "port",
          "display_name": "服务监听端口",
          "intrinsic_type": "number",
          "default_type": "number",
          "default_value": "11434",
          "presets": [
            "11434",
            "8000",
            "11888"
          ],
          "description": "对外暴露的 OpenAI 兼容 HTTP 服务端口"
        },
        {
          "name": "prompt",
          "display_name": "用户提示词 (Prompt)",
          "intrinsic_type": "string",
          "default_type": "string",
          "default_value": "",
          "presets": [],
          "description": "输入给大模型的提示词或提问内容"
        },
        {
          "name": "system_prompt",
          "display_name": "系统提示词 (System)",
          "intrinsic_type": "string",
          "default_type": "string",
          "default_value": "You are a helpful assistant.",
          "presets": [],
          "description": "大模型的系统预设角色与行为指令"
        },
        {
          "name": "temperature",
          "display_name": "采样温度",
          "intrinsic_type": "real",
          "default_type": "real",
          "default_value": "0.7",
          "presets": [
            "0.2",
            "0.7",
            "1.0"
          ],
          "description": "生成随机性控制参数"
        },
        {
          "name": "json_schema",
          "display_name": "结构化输出模式 (Schema)",
          "intrinsic_type": "string",
          "default_type": "string",
          "default_value": "",
          "presets": [],
          "description": "可选 JSON 结构规范，强制大模型输出合规结构化数据"
        }
      ],
      "output_type": "string"
    },
    {
      "tag": "OcrGeneral",
      "display_name": "通用文字识别 (OcrGeneral)",
      "icon": "📝",
      "platforms": "All",
      "description": "高精度识别图片或屏幕中的所有文字，输出完整文本内容与所在位置",
      "keywords": [
        "ocr",
        "text",
        "文字识别",
        "文本提取",
        "paddleocr",
        "通用识别"
      ],
      "fields": [
        {
          "name": "image",
          "display_name": "待识别图像",
          "intrinsic_type": "FilePicker",
          "default_type": "string",
          "default_value": "",
          "presets": [],
          "description": "待进行文字识别的图像路径或截屏内存变量"
        },
        {
          "name": "engine",
          "display_name": "推理引擎",
          "intrinsic_type": "string",
          "default_type": "string",
          "default_value": "auto",
          "presets": [
            "auto",
            "ppocr_v5",
            "ppocr_v4",
            "windows_native"
          ],
          "description": "选择 ONNX 模型或原生系统 OCR"
        },
        {
          "name": "enable_angle_cls",
          "display_name": "自适应方向校正",
          "intrinsic_type": "boolean",
          "default_type": "boolean",
          "default_value": "true",
          "presets": [
            "true",
            "false"
          ],
          "description": "是否对倒置或旋转的文本行进行自动矫正"
        },
        {
          "name": "score_threshold",
          "display_name": "置信度阈值",
          "intrinsic_type": "real",
          "default_type": "real",
          "default_value": "0.5",
          "presets": [
            "0.3",
            "0.5",
            "0.7",
            "0.9"
          ],
          "description": "过滤低置信度字符结果的门限值"
        }
      ],
      "output_type": "string"
    },
    {
      "tag": "OcrFindText",
      "display_name": "文字查找定位 (OcrFindText)",
      "icon": "🔎",
      "platforms": "All",
      "description": "在屏幕或图片中寻找指定的文字，返回文字坐标位置，可直接用于自动点击",
      "keywords": [
        "ocr",
        "find_text",
        "文字查找",
        "条件找字",
        "查找定位",
        "找字点击"
      ],
      "fields": [
        {
          "name": "image",
          "display_name": "待查找图像",
          "intrinsic_type": "FilePicker",
          "default_type": "string",
          "default_value": "",
          "presets": [],
          "description": "输入待查找的图像路径，留空表示全屏查找"
        },
        {
          "name": "target_text",
          "display_name": "目标文本",
          "intrinsic_type": "string",
          "default_type": "string",
          "default_value": "",
          "presets": [],
          "description": "需要查找的目标关键字或正则表达式"
        },
        {
          "name": "match_mode",
          "display_name": "匹配模式",
          "intrinsic_type": "string",
          "default_type": "string",
          "default_value": "contains",
          "presets": [
            "contains",
            "exact",
            "regex",
            "fuzzy"
          ],
          "description": "匹配模式：包含匹配、完全匹配、正则匹配或模糊相似度"
        },
        {
          "name": "score_threshold",
          "display_name": "相似度/置信度门限",
          "intrinsic_type": "real",
          "default_type": "real",
          "default_value": "0.6",
          "presets": [
            "0.5",
            "0.6",
            "0.8"
          ],
          "description": "文本匹配判定的相似度或 OCR 识别置信度阈值"
        }
      ],
      "output_type": "boolean"
    },
    {
      "tag": "VisualWait",
      "display_name": "视觉条件等待 (VisualWait)",
      "icon": "⏳",
      "platforms": "All",
      "description": "等待屏幕上出现或消失指定的文字或画面，常用于等待网页或软件加载完成",
      "keywords": [
        "visual_wait",
        "wait_element",
        "wait_text",
        "视觉等待",
        "条件等待",
        "异步等待"
      ],
      "fields": [
        {
          "name": "wait_type",
          "display_name": "等待类型",
          "intrinsic_type": "string",
          "default_type": "string",
          "default_value": "text_appear",
          "presets": [
            "text_appear",
            "text_disappear",
            "element_appear",
            "element_disappear"
          ],
          "description": "等待文字出现/消失，或等待 UI 元素出现/消失"
        },
        {
          "name": "target_pattern",
          "display_name": "目标匹配规则",
          "intrinsic_type": "string",
          "default_type": "string",
          "default_value": "",
          "presets": [],
          "description": "等待比对的目标文本或目标分类标签"
        },
        {
          "name": "timeout_seconds",
          "display_name": "最大超时(秒)",
          "intrinsic_type": "number",
          "default_type": "number",
          "default_value": "10",
          "presets": [
            "5",
            "10",
            "30",
            "60"
          ],
          "description": "超出该时间判定等待失败"
        },
        {
          "name": "interval_ms",
          "display_name": "轮询间隔(毫秒)",
          "intrinsic_type": "number",
          "default_type": "number",
          "default_value": "500",
          "presets": [
            "200",
            "500",
            "1000"
          ],
          "description": "两次屏幕检测之间的等待时间间隔"
        },
        {
          "name": "search_region",
          "display_name": "限定搜索区域",
          "intrinsic_type": "string",
          "default_type": "string",
          "default_value": "",
          "presets": [],
          "description": "可选 [x, y, w, h] 局限区域，大幅提升轮询帧率"
        }
      ],
      "output_type": "boolean"
    },
    {
      "tag": "OcrTable",
      "display_name": "表格结构提取 (OcrTable)",
      "icon": "📊",
      "platforms": "All",
      "description": "自动识别图片中的表格内容，并整理还原为标准表格数据",
      "keywords": [
        "table",
        "ocr_table",
        "表格识别",
        "表格提取",
        "结构化表格"
      ],
      "fields": [
        {
          "name": "image",
          "display_name": "输入表格图像",
          "intrinsic_type": "FilePicker",
          "default_type": "string",
          "default_value": "",
          "presets": [],
          "description": "包含表格的图片路径"
        },
        {
          "name": "output_format",
          "display_name": "输出格式",
          "intrinsic_type": "string",
          "default_type": "string",
          "default_value": "markdown",
          "presets": [
            "markdown",
            "json",
            "html"
          ],
          "description": "表格提取结果的数据组织格式"
        },
        {
          "name": "score_threshold",
          "display_name": "置信度阈值",
          "intrinsic_type": "real",
          "default_type": "real",
          "default_value": "0.5",
          "presets": [
            "0.3",
            "0.5",
            "0.7"
          ],
          "description": "单元格文字与边界预测置信度门限"
        }
      ],
      "output_type": "string"
    },
    {
      "tag": "BarcodeRecognition",
      "display_name": "增强型条码二维码识别 (BarcodeRecognition)",
      "icon": "📷",
      "platforms": "All",
      "description": "识别图片或屏幕上的二维码与条形码，即使模糊或倾斜也能精准扫码",
      "keywords": [
        "barcode",
        "qr",
        "qrcode",
        "条形码",
        "二维码",
        "扫码识别"
      ],
      "fields": [
        {
          "name": "image",
          "display_name": "输入图像",
          "intrinsic_type": "FilePicker",
          "default_type": "string",
          "default_value": "",
          "presets": [],
          "description": "包含一维码或二维码的图像文件路径"
